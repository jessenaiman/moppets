title: Found Things
id: found
tab: 13 · Found Things
about: 13 · The finale: the Found Things thank whoever left them behind
lead: tabby
key: D
bpm: 92
bass: none
beat: B . t . | Pf . t . | B . t . | Pf . t K (swing .1)
backing: vee +0, pip +2, scribe +4
finale: "Belong" = 1 0/3

# Verse voices in stage order: Spool (Pip), Clank, Cue (Scribe), Chip,
# Tabby, Hertz (Zap), Gruff, Clacker (Vee).
tune a = 0/.5 2/.5 4 4 5 4 2 4/2 | I 4, VI 4
tune b = 4 5/.5 7/.5 7 5 4 2 1/2 | IV 4, V 4
tune end = 4 5/.5 7/.5 5 4 2 1 0/2 | II 4, V 2, I 2
tune low = 4 4 5 4 2 1 0/2 | VI 4, IV 4
tune lift = 0 2 4 5 7/.5 7/.5 9 7/2 | IV 4, V 4

[verse 1]
rest 8
pip: "I was a tape left in a drawer" = a ; do nod
clank: "I was a fridge sized thinking box" = b ; do nod
scribe: "I was a script nobody read" = a ; do nod
chip: "I was a disk beneath a bed" = b ; do nod
tabby: "I was a screen that lost its glow" = a ; do nod
zap: "I was all snow until they came" = b ; do nod
gruff: "I was a tangle left for dead" = a ; do nod
vee: "I was the keys by the back door" = b ; do nod

[chorus]
"We are the found things put to use" = 4/.5 4/.5 5 7 7 5 4 2/2 | I 4, V 4
"Built from the bits that you let loose" = 2 2/.5 4/.5 5 5 4 2 1/2 | VI 4, V 4
"Thank you for all you left behind" = 4/.5 4/.5 5 7 8 7 5 4/2 | IV 4, I 4
"At four oh four we all belong" = 4 5/.5 4/.5 2 1 2 1 0/2 | II 4, V 2, I 2
  + chip @5: "Belong" = 3 2/2
  + gruff @5: "Belong" = -1 -2/2

[verse 2]
pip: "I kept a tape of one last show" = a ; do nod
clank: "I had a thought that no one heard" = b ; do nod
scribe: "I kept my last page blank for you" = a ; do nod
chip: "I kept a drawing someone drew" = b ; do nod
tabby: "I had a voice I kept inside" = a ; do nod
zap: "I caught one face between the lines" = b ; do nod
gruff: "I felt a tug along my wire" = 0/.5 2/.5 4 4 5 4 2 4 4 | I 4, VI 4 ; do nod
vee: "I knew one chord from that old show" = b ; do nod

[repeat chorus]

[verse 3]
pip: "I found the show. I pressed rewind" = a ; do nod
clank: "I said I'm here one beat behind" = b ; do nod
scribe: "My last page now says Take it, Chip" = a ; do nod
chip: "That drawing's me! Who pencilled it?" = b ; do nod
tabby: "I heard the tune and sang along" = a ; do nod
zap: "I lit the room so you could see" = b ; do nod
gruff: "I plucked my string. The floor hummed too" = a ; do nod
vee: "I played that chord. You knew it too" = b ; do nod

[repeat chorus]

[bridge]
vee: "I counted down to zero" = low ; do nod                       # Click on camera, Vee singing
clank: "Zero means there's nothing there" = low ; do tilt
"Quiet is a kind of song" = low
chip: "So let's count down again from ten" = lift ; do nod
  + scribe @7: "Places" = 4/.5 4/.5                                   # Biscuit

[repeat chorus]
