title: Found Things
id: found
tab: 13 · Found Things
about: 13 · The finale: the Found Things thank whoever left them behind
lead: tabby
key: D
bpm: 96
beat: B . t . | Pf . t . | B . t . | Pf . t K (swing .1)
backing: vee +0, pip +2, scribe +4
finale: "At four oh four we all belong" = 4/.5 5/.25 4/.25 2/.5 1/.5 2/.5 1/.5 0

# The words and story are docs/briefs/moppet-world.md. Cue, Biscuit and Watt have no CHIMERA voice
# yet, so for now Scribe's voice sings Cue's lines, Vee's sings Biscuit's and Pip's sings Watt's.
# The leads are Tabby (the tune), Chip (two steps above) and Gruff (two steps below); in the
# choruses the others pad the chords.

tune a = 0/.5 2/.5 4 4 5 4 2 4/2 | I 4, VI 4
tune b = 4 5/.5 7/.5 7 5 4 2 1/2 | IV 4, V 4
tune end = 4 5/.5 7/.5 5 4 2 1 0/2 | II 4, V 2, I 2
tune low = 4 4 5 4 2 1 0/2 | VI 4, IV 4
tune lift = 0 2 4 5 7/.5 7/.5 9 7/2 | IV 4, V 4

# Verse 1: everyone was something once. Spool (the VCR) and Hertz (the CRT, rabbit-ear aerial)
# have no voice yet: Pip's voice sings Spool's line and Vee's sings Hertz's. Hertz knew only
# static until he made friends, so he closes the verse.
[verse 1]
scribe: "I was the keys by the back door" = 3 5/.5 7/.5 7 5 4 1 1/2 | IV 4, V 4 ; do nod
  + clank @7: "beep" = 0
pip: "I was a tape left in a drawer" = b ; do nod                 # Spool
clank: "I was a fridge sized thinking box" = a ; do nod
scribe: "I was a script nobody read" = b ; do nod                 # Cue
gruff: "I was a tangle left for dead" = a ; do nod
chip: "I was a disk beneath a bed" = b ; do nod
  + gruff @7: "buzz" = 0
"I was a screen that lost its glow" = a ; do nod
vee: "I was all snow until they came" = end ; do nod              # Hertz

# Each return uses the original eight-bar tune and three-part harmony.
[chorus, choir]
"We are the found things put to use" = 4/.5 4/.5 5 7 7 5 4 2/2 | I 4, V 4
  + chip: "We are the found things put to use" = 6/.5 6/.5 7 9 9 7 6 4/2
  + gruff: "We are the found things put to use" = 2/.5 2/.5 3 5 5 3 2 0/2
"Built from the bits that you set loose" = 2 2/.5 4/.5 5 5 4 2 1/2 | VI 4, V 4
  + chip: "Built from the bits that you set loose" = 4 4/.5 6/.5 7 7 6 4 3/2
  + gruff: "Built from the bits that you set loose" = 0 0/.5 2/.5 3 3 2 0 -1/2
"Thank you for all you left behind" = 4/.5 4/.5 5 7 8 7 5 4/2 | IV 4, I 4
  + chip: "Thank you for all you left behind" = 6/.5 6/.5 7 9 10 9 7 6/2
  + gruff: "Thank you for all you left behind" = 2/.5 2/.5 3 5 6 5 3 2/2
"Look what we helped each other find" = 4 5/.5 4/.5 2 1 2 1 0/2 | II 4, V 2, I 2
  + chip: "Look what we helped each other find" = 6 7/.5 6/.5 4 3 4 3 2/2
  + gruff: "Look what we helped each other find" = 2 3/.5 2/.5 0 -1 0 -1 -2/2

# Verse 2: what nobody saw in them. Cue's blank last page closes it, and turns the song to growing.
[verse 2]
gruff: "I was a knot nobody tried" = a ; do nod
tabby: "I was a voice I kept inside" = b ; do nod
clank: "I was a thought that no one heard" = a ; do tilt
vee: "I was a list with just one word" = b ; do nod                # Biscuit
pip: "I was a plug that fit no wall" = a ; do nod                  # Watt
chip: "I was a drawing, that was all" = b ; do nod
pip: "I was a tape for late night's show" = a ; do nod              # Spool
scribe: "My last page blank, so we could grow" = end ; do nod      # Cue

[repeat chorus]

[verse 3]
scribe: "I found a card that said Stand By" = a ; do nod           # Cue
"So now I stand and wait nearby" = b ; do shrug
clank: "I found a sign that said On Air" = a ; do nod
gruff: "So I breathe in and hold it there" = b ; do nod
pip: "I found a plug that said Max Load" = a ; do tilt             # Watt
pip: "So I hold all the friends I know" = b ; do nod               # Watt
chip: "I found a box that said Be Kind" = a ; do nod
vee: "So I am kind and I rewind" = b ; do nod                      # Biscuit

[repeat chorus]

[bridge]
vee: "I counted down to zero" = low ; do nod                       # Click on camera, Vee singing
clank: "Zero means there's nothing there" = low ; do tilt
"Quiet is a kind of song" = low
chip: "So let's count down again from ten" = lift ; do nod
  + vee @7: "Places" = 4/.5 4/.5                                   # Biscuit

[repeat chorus]
