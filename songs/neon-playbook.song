key: D
bpm: 112
beat: B . t K | . Pf B . | t B . K | . B t . (swing .08)
backing: vee +0, pip +2, tabby +4, gruff +2, scribe +4, chip +7
finale: "Glow" on 7

tune hook = 0 2 4 5 | I 4
tune lift = 0 2 4 5 7 8 9/2 | IV 4, V 4

[act 1]
# Act I — One Crooked Tube (Neon & Cue fumble the 4-note starter hook)
vee: "One tube wakes up" = hook ; do tilt
scribe: "Wait my page is upside down" = 0 2 4 3 1 0 -1/2 | IV 4, V 4 ; do shrug ; react laugh
rest 2
vee: "One more time with both bright rings" = 0 2 4 5 4 2 4/2 | I 4, VI 4 ; do nod
  + scribe @2: "Twin tubes chime" = 4 5 4/2

[act 2]
# Act II — Neon & Tabby Counter-Melody Duet + Watt's Plug Slapstick
