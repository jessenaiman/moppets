  + tabby: "High ring climbs in harmony" = 9 7 5 7 5 4 2/2
pip: "Watch my cord it pulled too tight" = 4 5 6 7 8 7 8/2 | IV 4, V 4 ; do gasp
rest 2
gruff: "Watt unplugged the stage again" = 4 4 3 2 1 0 -1/2 | II 4, V 4 ; do shrug ; react laugh

[act 3]
# Act III — The Shelf Canon (Gruff, Watt, Chip & Clank) + Clank's Late Beat
gruff: "Step by step we pass the tune round" = 0 2 4 5 4 2 1 0 | I 4, V 4 ; do tilt
  + pip @2: "Step by step we pass it" = 2 4 5 4 2 0
  + chip @4: "Pass it round the room" = 7/.5 5/.5 4/.5 2/.5 0/2
