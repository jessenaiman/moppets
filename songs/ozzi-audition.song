title: Prince of Patchbays
id: ozzi-audition
tab: 00 · Ozzi Audition
about: Goth-Rock Ozzi clips his alligator-clip test probes onto a glowing tube amp and leads Gruff and Watt through a royal patchbay fanfare
lead: ozzi
key: E minor
bpm: 112
backing: gruff +0, watt +2, clank +0
bass: none
stage: band, ozzi, gruff, watt, clank
registers: ozzi -12, gruff -12, watt 0, clank -24
breath: .4
finale: "Four oh four" = 7 7 7/2

tune riff = 0 0/.5 2/.5 3 2 0/.5 -1/.5 0/2.6 | I 4, VII 2, I 2
tune chorus = 4 4/.5 5/.5 7 5 4/.5 2/.5 0/2.6 | IV 4, I 4

[intro fanfare]
ozzi: "Hear the prince of the patchbay call!" = 0 2/.5 3/.5 5 7 5/.5 3/.5 0/2.6 | I 4, V 2, I 2 ; do cheer ; move left 4 ; cam wide
gruff: "Big bass call!" = -2/.4 0/.4 -2/.8 | I 2 ; move right 4
watt: "Plug us all!" = 0/.4 2/.4 4/.8 | I 2 ; jump 1.5

[verse 1]
ozzi: "Purple specs on green phosphor glow" = riff ; do nod ; take adjust-specs ; cam closeup
