{
  "name": "moppets",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run chimera:update && vite --host 127.0.0.1",
    "build": "bun run chimera:update && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun run check",
    "check": "bun tools/playwright-check.ts",
    "typecheck": "tsc --noEmit",
    "character:webm": "bun tools/export-character-webm.ts",
    "wasm": "cargo build -p moppet-wasm --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/moppet_wasm.wasm src/audio/moppet.wasm",
    "chimera:update": "git submodule update --init --recursive -- chimera && git -C chimera log --oneline -1 && bun run wasm"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@react-three/fiber": "^9.8.2",
    "@remotion/media": "4.0.545",
    "@remotion/player": "4.0.545",
    "@remotion/three": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "three": "0.186.1",
    "vexflow": "^5.3.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.545",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
